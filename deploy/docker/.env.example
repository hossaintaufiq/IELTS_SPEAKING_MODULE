# Copy to deploy/docker/.env on the server and fill in. Never commit .env or paste its values into a chat.
# Make each key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# The key ieltsup's server uses (comma separated list, one per caller).
SERVICE_API_KEYS=
# Opens the monitoring page (internal port).
MONITOR_KEY=
# Signs the short-lived browser tokens; at least 32 characters. Changing it voids every token.
TOKEN_SECRET=

# The websites whose pages may open a test, comma separated, exact, https. Empty: no browser can connect.
# ieltsup's documents list https://test.ieltsup.io (production) and https://staging-test.ieltsup.org (staging): confirm first.
ALLOWED_ORIGINS=

# Tests at the same time on this GPU.
MAX_SESSIONS=10
# Days a test's record, recording and server logs are kept (0: for ever).
RETENTION_DAYS=30
